{
  "name": "@dnd/source",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "nx serve web",
    "dev:api": "nx serve api",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "cd apps/api && bunx drizzle-kit generate",
    "db:migrate": "cd apps/api && bunx drizzle-kit migrate",
    "db:seed": "bun run apps/api/src/seed.ts",
    "srd:import": "bun run scripts/import-srd-catalog.ts",
    "srd:import:classes": "bun run scripts/import-dndsu-classes.ts",
    "srd:import:items": "bun run scripts/import-dndsu-items.ts",
    "srd:import:spells": "bun run scripts/import-dndsu-spells.ts",
    "srd:import:monsters": "bun run scripts/import-dndsu-monsters.ts",
    "srd:import:backgrounds": "bun run scripts/import-dndsu-backgrounds.ts",
    "srd:import:feats": "bun run scripts/import-dndsu-feats.ts"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@mantine/core": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@mantine/notifications": "^9.3.1",
    "@tabler/icons-react": "^3.44.0",
    "@virentia/core": "^0.11.1",
    "@virentia/forms": "^0.2.3",
    "@virentia/forms-react": "^0.2.3",
    "@virentia/forms-zod": "^0.1.4",
    "@virentia/net-core": "^0.1.3",
    "@virentia/net-react": "^0.1.3",
    "@virentia/react": "^0.5.1",
    "@virentia/router": "^0.4.1",
    "@virentia/router-paths": "^0.1.2",
    "@virentia/router-react": "^0.4.1",
    "@virentia/storage-core": "^0.1.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "history": "^5.3.0",
    "konva": "^10.0.12",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint-react/eslint-plugin": "^5.9.0",
    "@nx/js": "^22.7.5",
    "@nx/react": "^22.7.5",
    "@nx/vite": "^22.7.5",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "nx": "^22.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
