{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@dnd/shared": ["packages/shared/src/index.ts"],
      "@dnd/shared/*": ["packages/shared/src/*"]
    },
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "tmp", "dist", ".agents"]
}
